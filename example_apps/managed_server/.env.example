# Required. The port the server binds on 0.0.0.0. No default — the
# process refuses to start without it (a managed box always sets it).
PORT=8080

# Optional. A managed box injects both of these as app_env in launch.json;
# GET /which answers null for whichever is absent (e.g. running locally).
SIMPLE_SERVER_ID=
APP_VERSION=

# Optional. This server's own credential at the platform's simple-* hosts —
# identifies THIS server of THIS app, acting as the owner through the app;
# never a user. A managed box injects it as app_env in launch.json; GET
# /platform answers 503 {"error":"no_backend_token"} when it is absent
# (e.g. running locally). Revoked the moment the server is removed.
PILELY_BACKEND_TOKEN=
