# Required. The port the server binds on 0.0.0.0. No default — the
# process refuses to start without it (a managed box always sets it).
PORT=8080

# Optional. A managed box injects both of these as app_env in launch.json;
# GET /which answers null for whichever is absent (e.g. running locally).
SIMPLE_SERVER_ID=
APP_VERSION=
