# Loaded only by `npm run dev:mock` (vite --mode mock). Turns on mock mode:
# every @pilely package answers from in-memory fakes. See README.md.
VITE_PILELY_MOCK=1
# The mock runtime signs in as `mock_user`; naming it the owner here makes
# the owner's screens (drafts, editor, edit/delete, moderation) reachable.
VITE_OWNER_HANDLE=mock_user
